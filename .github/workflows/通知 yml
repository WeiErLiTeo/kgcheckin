name: 早上8点推送
on:
  workflow_dispatch:
  schedule:
    - cron: '5 0 * * *'
permissions:
  contents: write
jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - name: 检出仓库
        uses: actions/checkout@v4
      - name: 读取日志并推送到微信
        run: |
          if [ -f log/checkin.txt ]; then
            node -e '
              const fs = require("fs");
              let content = fs.readFileSync("log/checkin.txt", "utf8");
              const token = process.env.PUSHPLUS_TOKEN;
              if (!token) {
                console.error("未配置 PUSHPLUS_TOKEN");
                process.exit(1);
              }
              content = content.replace(/\x1b\[[0-9;]*[a-zA-Z]/g, "").replace(/\r\n/g, "\n").replace(/\n/g, "<br>");
              fetch("https://www.pushplus.plus/send", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  token: token,
                  title: "酷狗音乐打卡通知",
                  content: content
                })
              })
              .then(res => res.json())
              .then(data => {
                console.log("推送结果:", data);
                if (data.code !== 200) process.exit(1);
              })
              .catch(err => {
                console.error("推送网络异常:", err);
                process.exit(1);
              });
            '
            rm -f log/checkin.txt
            git config --local user.name "github-actions[bot]"
            git config --local user.email "github-actions[bot]@users.noreply.github.com"
            git add -A log/
            git commit -m "chore: clean checkin log" || exit 0
            git pull --rebase
            git push
          else
            echo "未找到 log/checkin.txt 文件，跳过本次推送"
          fi
        env:
          PUSHPLUS_TOKEN: ${{ secrets.PUSHPLUS_TOKEN }}
